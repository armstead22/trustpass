# =====================================================================
# TrustPass environment configuration
# Copy to .env and fill in. NEVER commit a real .env.
# =====================================================================

# ---- App ----
NODE_ENV=development                # development | production
PORT=5000
DEMO_MODE=true                      # when true, silences the dev-key warning (demo only)

# ---- Database ----
DB_PATH=data.db                     # SQLite path (demo). In prod use Postgres via docker-compose.
# DATABASE_URL=postgresql://trustpass:secret@postgres:5432/trustpass

# ---- Encryption (AES-256-GCM PII at rest) ----
# Derives the AES key via scrypt. MUST be >= 16 chars and random in production.
ENCRYPTION_KEY=change-me-to-a-long-random-secret

# ---- Auth (JWT) ----
# JWT access tokens (15 min) + refresh tokens (7 days, httpOnly cookie).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
REFRESH_COOKIE=trustpass_refresh

# ---- Stellar blockchain ----
# mock     = generate a fake tx hash, no network (default, for dev/demo)
# testnet  = submit a REAL transaction to Stellar Testnet (requires funded issuer)
# mainnet  = submit to Stellar Mainnet (production — use with care)
STELLAR_MODE=mock
# Required only when STELLAR_MODE != mock:
# STELLAR_ISSUER_SECRET=S...   (fund this account on testnet: https://laboratory.stellar.org)

# ---- KYC provider (Persona / Jumio) ----
# If unset, a clearly-labeled MOCK KYC provider is used (see server/lib/kyc.ts).
# KYC_PROVIDER=persona
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=
# JUMIO_API_TOKEN=
# JUMIO_API_SECRET=

# ---- Email (SendGrid / Resend) ----
# If unset, transactional emails are mocked to the server log (server/lib/email.ts).
# SENDGRID_API_KEY=
# EMAIL_FROM=TrustPass <no-reply@trustpass.io>

# ---- SMS / OTP (Twilio) ----
# If unset, OTP delivery is mocked (code printed in server logs in dev).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# ---- Storage (encrypted document uploads) ----
# Documents are encrypted before upload; plaintext is never stored.
# S3_BUCKET=trustpass-docs
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Cloudinary fallback:
# CLOUDINARY_URL=

# ---- CORS allowlist (comma-separated, no wildcards in production) ----
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# ---- Rate limiting ----
# Auth routes: 20/min/IP · API routes: 100/min/IP (configured in server/routes.ts)
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=100
